<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>es.tragsa.sido</groupId>
    <artifactId>backend-tests</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <name>backend-tests</name>

    <properties>
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <junit.jupiter.version>5.10.2</junit.jupiter.version>
        <unirest.version>3.14.5</unirest.version>
        <jackson.version>2.17.1</jackson.version>
        <json.schema.validator.version>1.0.88</json.schema.validator.version>
        <maven.surefire.plugin.version>3.2.5</maven.surefire.plugin.version>
        <sido.backend.baseUri/>
        <sido.backend.token/>
        <sido.backend.clientId/>
        <sido.backend.clientVersion/>
        <sido.backend.timeoutMs/>
        <sido.backend.verifySsl/>
        <sido.backend.scenario/>
        <backend.excludedGroups>mutating</backend.excludedGroups>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.jupiter.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.konghq</groupId>
            <artifactId>unirest-java</artifactId>
            <version>${unirest.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.networknt</groupId>
            <artifactId>json-schema-validator</artifactId>
            <version>${json.schema.validator.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven.surefire.plugin.version}</version>
                <configuration>
                    <useModulePath>false</useModulePath>
                    <trimStackTrace>false</trimStackTrace>
                    <excludedGroups>${backend.excludedGroups}</excludedGroups>
                    <systemPropertyVariables>
                        <sido.backend.baseUri>${sido.backend.baseUri}</sido.backend.baseUri>
                        <sido.backend.token>${sido.backend.token}</sido.backend.token>
                        <sido.backend.clientId>${sido.backend.clientId}</sido.backend.clientId>
                        <sido.backend.clientVersion>${sido.backend.clientVersion}</sido.backend.clientVersion>
                        <sido.backend.timeoutMs>${sido.backend.timeoutMs}</sido.backend.timeoutMs>
                        <sido.backend.verifySsl>${sido.backend.verifySsl}</sido.backend.verifySsl>
                        <sido.backend.scenario>${sido.backend.scenario}</sido.backend.scenario>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
